# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# simulate_study.py output (regenerable) -- anchored so it does not match
# the per-study results/ folders under numerical_study/
/results/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Monte-Carlo output (regenerable via numerical_study/run_paper.py and
# run_informative.py); the .csv summaries under bic_model_selection/ are kept.
numerical_study/simulation_study/random_censoring/results/
numerical_study/simulation_study/informative_censoring/results/

# simulate_study.py figures -- superseded by numerical_study/simulation_study/plots/
/plots/

# Manuscript sources and review material -- kept private
latex/
review/

# MIMIC-III derived data: credentialed access (PhysioNet DUA), never publish
mimic_analysis/merged_data/
mimic_analysis/doc/

# BIC runs superseded by the numerical fix: kept locally for provenance, not published.
numerical_study/bic_model_selection/archive/

# Backups and editor leftovers
*.bak

# Exploratory MIMIC scripts and data (the analysis reported in the paper is in
# mimic_study/; its patient-level intermediate files go to mimic_study/output/)
mimic_analysis/
mimic_study/output/

# Exploratory numerical studies that are not reported in the paper
numerical_study/knot_bic.py
numerical_study/knot_cv.py
numerical_study/knot_robustness.py
